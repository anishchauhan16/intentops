# Non-secret demo settings. The app reads process environment, not .env files.
# Docker: --env-file .env.example. Local: export desired values before starting.
PORT=8000
INTENTOPS_ARTIFACT_DIR=artifacts
INTENTOPS_REVIEW_THRESHOLD=0.70
INTENTOPS_SEMANTIC_ENABLED=false
INTENTOPS_SEMANTIC_MIN_SIMILARITY=0.65
INTENTOPS_SEMANTIC_MIN_VOTE=0.70
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
